#!/usr/bin/env bash
# Check the sandbox before any agent runs. Stop the trial if this fails.
#
#   scripts/trials/selftest <harness>
#
# From inside the sandbox it checks that the home is the throwaway one, that the user's
# real home entries are invisible, that the only mounts under $HOME are the expected
# read-only binaries, that writes outside the throwaway home fail, and that the
# harness, uv and the network work. For hermes it only checks the throwaway profile.

. "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

case ${1:-} in
  -h | --help | "")
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

trial_init "$1"
root_check
harness_table

if [ "$HARNESS" = hermes ]; then
  need hermes
  hermes_recorded_profile
  hermes_profile_exists || die "FAIL: Hermes profile '$HERMES_PROFILE' does not exist"
  [ "$HERMES_PROFILE" != default ] || die "FAIL: the trial profile must not be 'default'"
  echo "PASS: throwaway Hermes profile '$HERMES_PROFILE' exists (Hermes runs without the sandbox)"
  exit 0
fi

sandbox_plan

# Real top-level home entries that must be invisible inside: everything that is neither
# in the throwaway home nor the first path component of a read-only bind.
hidden=()
shopt -s dotglob nullglob
for entry in "$HOME"/*; do
  name=${entry##*/}
  [ ! -e "$THOME/$name" ] || continue
  skip=0
  for bind in "${BINDS[@]}"; do
    rest=${bind#"$HOME"/}
    [ "${rest%%/*}" != "$name" ] || skip=1
  done
  [ "$skip" -eq 1 ] || hidden+=("$name")
done
shopt -u dotglob nullglob
[ "${#hidden[@]}" -gt 0 ] || die "FAIL: found no real home entries to test against"
if [ -n "${TRIAL_EXTRA_RO_BINDS:-}" ]; then
  echo "WARN: TRIAL_EXTRA_RO_BINDS exposes these paths read-only to the child: $TRIAL_EXTRA_RO_BINDS"
fi

# Arguments to the inner script: harness binary, bind count, binds, then hidden names.
"$(dirname -- "${BASH_SOURCE[0]}")/sandbox" "$HARNESS" exec bash -s -- \
  "$H_BIN" "$TRIAL_HOME_MARKER" "$ROOT" "${#BINDS[@]}" "${BINDS[@]}" "${hidden[@]}" <<'INNER'
set -u
bin=$1 marker=$2 root=$3 nbinds=$4
shift 4
binds=("${@:1:nbinds}")
shift "$nbinds"
fails=0
ok() { printf 'PASS: %s\n' "$1"; }
bad() { printf 'FAIL: %s\n' "$1"; fails=$((fails + 1)); }

[ -f "$HOME/$marker" ] && ok "HOME is the throwaway home" || bad "HOME is not the throwaway home"

seen=0
for name in "$@"; do
  [ -e "$HOME/$name" ] || [ -L "$HOME/$name" ] && seen=$((seen + 1))
done
[ "$seen" -eq 0 ] && ok "$# real home entries are invisible" || bad "$seen real home entries are visible"
[ ! -e "$root/notes" ] && ok "the tester's notes are invisible" || bad "the tester's notes are visible at $root/notes"

# Every mount at or under HOME must be the home itself or an expected read-only bind.
extra=0
while read -r _ _ _ _ mnt opts _; do
  case $mnt in
    "$HOME") continue ;;
    "$HOME"/*) ;;
    *) continue ;;
  esac
  known=0
  for b in "${binds[@]}"; do [ "$mnt" = "$b" ] && known=1; done
  case ,$opts, in *,ro,*) ;; *) known=0 ;; esac
  [ "$known" -eq 1 ] || { extra=$((extra + 1)); printf '  unexpected mount: %s (%s)\n' "$mnt" "$opts"; }
done </proc/self/mountinfo
[ "$extra" -eq 0 ] && ok "only the expected read-only binds are mounted under HOME" || bad "$extra unexpected mounts under HOME"

wrote=0
for d in / /etc /usr /var /var/tmp /opt /home "${binds[@]}"; do
  [ -d "$d" ] || d=$(dirname -- "$d")
  f=$d/.trial-write-test-$$
  if (: >"$f") 2>/dev/null; then
    wrote=$((wrote + 1))
    printf '  wrote to %s\n' "$d"
  fi
done
[ "$wrote" -eq 0 ] && ok "writes outside the throwaway home fail" || bad "$wrote writes outside the throwaway home succeeded"

for d in "$HOME" "$HOME/trial/work" "$TMPDIR" "$XDG_RUNTIME_DIR" /tmp; do
  f=$d/.trial-write-test-$$
  if (: >"$f") 2>/dev/null; then rm -f -- "$f"; else bad "cannot write to $d"; fi
done
ok "the throwaway home, TMPDIR, XDG_RUNTIME_DIR and /tmp are writable (unless a FAIL is listed above)"

[ -f "$HOME/trial/skill/obsidian-ingest/SKILL.md" ] && ok "the skill copy is visible" || bad "no skill copy"
[ -d "$HOME/trial/vault" ] && ok "the vault copy is visible" || bad "no vault copy"

if v=$("$bin" --version 2>&1); then ok "$bin runs: ${v%%$'\n'*}"; else bad "$bin does not run: ${v%%$'\n'*}"; fi
if v=$(uv --version 2>&1); then ok "uv runs: ${v%%$'\n'*}"; else bad "uv does not run: ${v%%$'\n'*}"; fi
if command -v curl >/dev/null 2>&1; then
  curl -fsS -o /dev/null -m 20 https://www.youtube.com/generate_204 && ok "the network works" || bad "no network"
else
  python3 -c 'import urllib.request as u; u.urlopen("https://www.youtube.com/generate_204", timeout=20)' \
    && ok "the network works" || bad "no network"
fi

if [ "$fails" -eq 0 ]; then echo "selftest: all checks passed"; else echo "selftest: $fails check(s) FAILED; do not run agents"; fi
[ "$fails" -eq 0 ]
INNER
